# Copia este archivo como .env solo como referencia. El proyecto lee VARIABLES DE ENTORNO
# (se definen en cada terminal, ver README). NUNCA subas claves, tokens ni un .env real.

# --- Proceso del bot (bot_telegram.py) ---
TELEGRAM_BOT_TOKEN=      # token entregado por @BotFather
GROQ_API_KEY=            # clave de Groq
GROQ_MODEL=              # ID de un modelo habilitado en tu cuenta de Groq
CHATBOT_API_URL=http://127.0.0.1:8011   # dirección de FastAPI (por defecto esa)
API_PRIVATE_KEY=         # clave inventada por el equipo; debe ser IGUAL en FastAPI y en el bot

# --- Proceso de FastAPI (uvicorn main:app) ---
# API_PRIVATE_KEY (la misma de arriba)
# RESERVAS_DB=           # opcional: ruta de la base SQLite (por defecto ./reservas.db)
